# ==========================================================================
# RANGAMAI.in — Environment variables (PLACEHOLDERS ONLY — never commit real secrets)
# Copy to .env.local (per app) or .env and fill in. .env* is gitignored.
# ==========================================================================

# --- Public website (apps/web) ---
# Base URL of the site, used for SEO metadataBase, canonical URLs, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL. Unused in the current phase (site runs on seed content);
# wired up when the NestJS API lands.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ==========================================================================
# The variables below are NOT used yet in this phase. Listed so the eventual
# backend / integrations have a documented contract. Fill them only when the
# corresponding phase begins.
# ==========================================================================

# --- Backend / Database (later: NestJS + MongoDB Atlas) ---
# DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=1d

# --- Media (later: Cloudinary) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Email (later: Resend) ---
# RESEND_API_KEY=
# CONTACT_NOTIFICATION_EMAIL=hello@rangamai.in
