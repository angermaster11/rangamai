# ==========================================================================
# RANGAMAI.in — Environment variables (PLACEHOLDERS ONLY — never commit real secrets)
# Copy the relevant block into a per-app .env.local and fill it in.
# Every .env* except this .env.example is gitignored.
# ==========================================================================

# --------------------------------------------------------------------------
# apps/web  →  apps/web/.env.local
# --------------------------------------------------------------------------
# Base URL of the public site: SEO metadataBase, canonical URLs, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend API base URL. When set, the site reads live content from the API
# (with seed fallback if the API is unreachable). Also used by the contact
# route to forward leads server-side.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --------------------------------------------------------------------------
# apps/admin  →  apps/admin/.env.local
# --------------------------------------------------------------------------
# API the dashboard talks to (browser-side, with credentials).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site URL, for the "View site" link in the admin topbar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------------
# apps/api  →  apps/api/.env.local
# --------------------------------------------------------------------------
# Server
PORT=4000
# Local MongoDB (dev). Swap for an Atlas SRV URI in later phases.
MONGODB_URI=mongodb://127.0.0.1:27017/rangamai

# Auth — JWT is signed with this secret; use a long random value (>=32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Cookie carrying the JWT. Set COOKIE_SECURE=true behind HTTPS (production).
COOKIE_SECURE=false
COOKIE_NAME=rangamai_token
# Comma-separated origins allowed by CORS (web + admin dev servers).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seed admin — created/updated idempotently by `npm run seed`.
# The password is hashed with bcrypt before storage; the plaintext lives ONLY
# in this gitignored file. Change it before any non-local use.
ADMIN_EMAIL=admin@rangamai.in
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=RANGAMAI Admin

# Media — Cloudinary (real integration). Leave blank to disable uploads;
# the media endpoints then return 503 until keys are provided.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that uploads are stored under in your Cloudinary account.
CLOUDINARY_FOLDER=rangamai

# --------------------------------------------------------------------------
# Not used yet (later phases)
# --------------------------------------------------------------------------
# Email notifications are a dev-log stub for now (no provider configured).
# When an official inbox + provider exist:
# RESEND_API_KEY=
# CONTACT_NOTIFICATION_EMAIL=hello@rangamai.in
